# Credenciales de AWS Academy — copiar a .env.aws y llenar con los valores reales.
# .env.aws está en .gitignore — NUNCA commitear con valores reales.
#
# Cómo obtenerlas:
#   Portal Academy → Start Lab → AWS Details → Show
#   Copiar los 3 valores y pegarlos abajo.
#   Se renuevan cada ~4 horas al reiniciar el lab.

AWS_ACCESS_KEY_ID=ASIA...
AWS_SECRET_ACCESS_KEY=...
AWS_SESSION_TOKEN=...
AWS_DEFAULT_REGION=us-east-1

# IDs de los recursos AWS (se llenan automáticamente tras el primer provision_aws.py)
S3_BUCKET=
CLOUDFRONT_DISTRIBUTION=
CLOUDFRONT_DOMAIN=
